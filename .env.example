# ==========================================
# BREWLITE MONOREPO - ENVIRONMENT VARIABLES
# ==========================================

# --- PostgreSQL Database ---
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_secret
POSTGRES_DB=brewlite2_db
POSTGRES_PORT=5432

# --- NestJS Backend API (apps/api) ---
DATABASE_URL="postgresql://brewlite:brewlite_secret@localhost:5432/brewlite2_db?schema=public"
PORT=4000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# --- Next.js Frontend Web/PWA (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=BrewLite
